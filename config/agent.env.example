# pi-mom-local 設定檔
# 用法：cp config/agent.env.example config/agent.env 後填入自己的值
# agent.env 已被 .gitignore 擋住，不會進版控。

# ── Slack ───────────────────────────────────────────────────────────
# 兩個都在 https://api.slack.com/apps 你的 App 頁面取得。
# App-Level Token（Basic Information → App-Level Tokens，scope: connections:write）
MOM_SLACK_APP_TOKEN=xapp-請填入
# Bot User OAuth Token（OAuth & Permissions）
MOM_SLACK_BOT_TOKEN=xoxb-請填入

# ── 本地模型 ─────────────────────────────────────────────────────────
# HOST 對應 config/hosts/<HOST>.json，同時也是該檔案裡的 provider 名稱。
# 內建：ollama / lmstudio / llamacpp / vllm。要加新的就放一個同名 JSON 進去。
HOST=ollama
# 模型 id，必須出現在 config/hosts/<HOST>.json 的 models 陣列裡
LLM_MODEL=gemma4-32k

# ── Runtime ─────────────────────────────────────────────────────────
# 對應 runtimes/<RUNTIME>/，目前只有 mom
RUNTIME=mom

# ── 沙箱 ────────────────────────────────────────────────────────────
# docker:<容器名> = agent 的 bash 跑在容器裡（建議；Slack 上任何人都能對它下指令）
# host            = 直接跑在你的機器上（只用於除錯，不要當常態）
SANDBOX=docker:pi-mom-sandbox

# ── 沙箱 image ──────────────────────────────────────────────────────
# 由 sandbox/Dockerfile 建出來（內含 curl / lynx / jq）。
# start 會自動建置；Dockerfile 改過之後會偵測到並重建容器。
SANDBOX_IMAGE=pi-mom-sandbox:local

# 沙箱時區（POSIX 格式；alpine 沒有 tzdata，不能寫 Asia/Taipei）。留空＝CST-8（UTC+8）
SANDBOX_TZ=

# ── search skill 的憑證（可留空）──────────────────────────────────────
# 留空時 fetch 照常可用，只有 search 會回「還沒設 key」。
# brave  → https://api.search.brave.com/app/keys
#          每月 $5 免費額度（約 1,000 次），**要綁信用卡**
# tavily → https://app.tavily.com/home
#          每月 1,000 credits。官方文件寫不需信用卡，但實際註冊仍要綁卡（2026-09-15 實測）。
# searxng → 自架，**不需要任何 key、不需要綁卡**（見 bin/searxng.sh、TASK-049）
#          搜尋查詢不會離開你的機器；代價是量大時會被上游引擎擋。
# 三選一：searxng（免 key）／brave／tavily
SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# ── 本機產圖（FLUX.2 Klein 4B，見 packages/image-router/README.md）──────────
# 1 = 啟用 generate_image 工具與 `!img` 指令。需要先跑 bin/image-setup.sh 下載模型、
# 並放好 sd-server（stable-diffusion.cpp 的 CUDA 版）。
IMAGE_ENABLED=0
# 留空 = $STATE_DIR/bin/sd-server
IMAGE_SD_SERVER_BIN=
# 留空 = $STATE_DIR/models/image/flux2（舊配置的 models/image 也認得）
IMAGE_MODEL_DIR=
IMAGE_DIFFUSION_MODEL=flux-2-klein-4b-Q4_0.gguf
# abliterated（去審查）的 Qwen3-4B 文字編碼器
IMAGE_LLM=Qwen3-4B-abliterated.Q4_K_M.gguf
IMAGE_VAE=flux2-klein-vae.safetensors
# NSFW LoRA（選用，預設停用）：只在 `!img ... --nsfw` 或工具參數 nsfw:true 時套用，一般產圖不受影響。
# 要用的話：`bin/image-setup.sh --with-nsfw` 下載（需要 CIVITAI_TOKEN），或自己放進 $IMAGE_MODEL_DIR/nsfw/，
# 再填檔名，例如 IMAGE_NSFW_LORA=party_time_v2.1_klein4b.safetensors。留空 = 停用 --nsfw。
# 只用在文字描述的虛構成人；`!edit`（可能是真人照片）一律不套用。
# 2026-11-20 RTX 2060 實測：套用時每張多約 14 秒（+40%）、VRAM 峰值 +0.56GB
IMAGE_NSFW_LORA=
IMAGE_NSFW_LORA_WEIGHT=1.0
# 一般 LoRA：把 .safetensors 放進 $IMAGE_MODEL_DIR/loras/ 就能用（可以有子資料夾，不用重啟）。
#   `!img ... --lora`  用預設那個；`--lora2` 用排序第 2 個（`!lora` 列出編號）；超過檔案數就不套用。
#   可以和 --nsfw 一起用；`!edit` 也能用，但檔名像 NSFW 的不套用。
# IMAGE_LORA：預設那個（loras/ 裡的相對路徑，例如 european/face_v2.safetensors）；留空 = 排序第一個。改了要重啟。
# IMAGE_LORA_DIR 可改，但要和 nsfw/ 同一層。
IMAGE_LORA=
IMAGE_LORA_WEIGHT=0.6
# 不用 sd-server 預設的 1234（會和 LM Studio 撞）
IMAGE_PORT=7861
# ram  = （預設）sd-server 加 --offload-to-cpu，權重放在 RAM（約 4.9GB），閒置時只佔 VRAM 約 0.6GB
# vram = 不加 --offload-to-cpu
# 兩種模式都一樣：產完常駐 IMAGE_KEEP_ALIVE，有對話要用 GPU 時先關掉 sd-server
# （閒置的 0.6GB 也會把對話模型擠一部分到 CPU）。2026-11-20 RTX 2060 實測兩種模式速度相同（768×1024 約 38 秒）
IMAGE_RESIDENT_MODE=ram
# sd-server 閒置多久後自動關掉（10m / 90s / 0 = 產完就關）
IMAGE_KEEP_ALIVE=10m
IMAGE_DEFAULT_SIZE=768x1024
IMAGE_DEFAULT_STEPS=4
# 逾時 = max(預估時間 × 倍數, 最少秒數)
IMAGE_TIMEOUT_FACTOR=3
IMAGE_MIN_TIMEOUT_SEC=180
# 產圖前 VRAM 至少要空出多少 MB
IMAGE_VRAM_NEED_MB=4500

# ── 路徑（可留空用預設值）─────────────────────────────────────────────
# STATE_DIR：對話歷史、隔離用 HOME、log 都放這裡。預設 ~/.pi-mom-local
STATE_DIR=
